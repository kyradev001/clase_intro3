      overflow: hidden;
      animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    @keyframes modalPop {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-image-header {
      position: relative;
      height: 240px;
      width: 100%;
      background: #F1EBE4;
    }

    .modal-image-header img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .btn-modal-close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(28, 25, 23, 0.8);
      color: white;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .btn-modal-close:hover {
      background: #000000;
    }

    .modal-body {
      padding: 1.75rem;
    }

    .modal-title-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5rem;
    }

    .modal-title {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .modal-price {
      font-size: 1.6rem;
      font-weight: 900;
      color: var(--accent);
    }

    .modal-badge-wrapper {
      margin-bottom: 1rem;
    }

    .modal-desc {
      font-size: 0.95rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }

    .modal-section-title {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }

    .ingredients-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .ing-tag {
      background: #F8FAFC;
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .modal-specs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      background: var(--surface-subtle);
      border-radius: var(--radius-sm);
      padding: 1rem;
      margin-bottom: 1.75rem;
    }

    .modal-spec-col {
      text-align: center;
    }

    .modal-spec-col span {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .modal-spec-col strong {
      font-size: 0.9rem;
      color: var(--text-main);
      font-weight: 800;
    }

    .modal-footer-cta {
      display: flex;
      gap: 0.85rem;
    }

    .modal-btn-order {
      flex: 1;
      background: linear-gradient(135deg, #EA580C, #D97706);
      color: white;
      text-decoration: none;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      font-weight: 800;
      text-align: center;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.3);
      transition: all 0.2s;
    }

    .modal-btn-order:hover {
      background: linear-gradient(135deg, #C2410C, #B45309);
    }

    /* PWA Banner */
    .pwa-promo-box {
      background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 50%, #FDE68A 100%);
      border: 1px solid #FCD34D;
      border-radius: var(--radius-lg);
      padding: 3.5rem 3rem;
      margin: 2rem auto 5rem;
      max-width: 1280px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      box-shadow: var(--shadow-md);
    }

    .pwa-promo-content h3 {
      font-size: 2.2rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: #78350F;
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }

    .pwa-promo-content p {
      font-size: 1.05rem;
      color: #92400E;
      max-width: 580px;
      margin-bottom: 1.5rem;
    }

    /* Footer */
    footer.site-footer {
      background: #FFFFFF;
      border-top: 1px solid var(--border);
      padding: 4rem 2rem 2rem;
    }

    .footer-container {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .footer-col h5 {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text-main);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1.2rem;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .footer-col ul a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .footer-col ul a:hover {
      color: var(--accent);
    }

    .footer-bottom {
      max-width: 1280px;
      margin: 0 auto;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 1rem;
    }

    @media (max-width: 960px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 2rem;
        gap: 2.5rem;
      }
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .pwa-promo-box {
        flex-direction: column;
        text-align: center;
        padding: 2.5rem 1.5rem;
      }
      .footer-container {
        grid-template-columns: 1fr 1fr;
      }
      .nav-links {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .hero-title {
        font-size: 2.5rem;
      }
      .features-grid {
        grid-template-columns: 1fr;
      }
      .burgers-grid {
        grid-template-columns: 1fr;
      }
      .footer-container {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
