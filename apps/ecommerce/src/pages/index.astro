  <!-- Client-Side Interactivity (Modal & Filtering) -->
  <script is:inline>
    // Filter buttons handling
    const filterBtns = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        burgerCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Handling
    const modal = document.getElementById('burgerModal');
    const closeBtn = document.getElementById('modalCloseBtn');
    const secondaryClose = document.getElementById('modalSecondaryClose');
    const detailBtns = document.querySelectorAll('.btn-details[data-name]');

    const modalTitle = document.getElementById('modalTitle');
    const modalBadge = document.getElementById('modalBadge');
    const modalPrice = document.getElementById('modalPrice');
    const modalDesc = document.getElementById('modalDesc');
    const modalImg = document.getElementById('modalImg');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalCalories = document.getElementById('modalCalories');
    const modalPrepTime = document.getElementById('modalPrepTime');
    const modalCooking = document.getElementById('modalCooking');

    function openDetailsModal(data) {
      modalTitle.textContent = data.name;
      modalPrice.textContent = '$' + data.price;
      modalDesc.textContent = data.desc;
      modalImg.src = data.image;
      modalImg.alt = data.name;
      modalBadge.textContent = data.badge;
      modalBadge.className = 'badge-specialty ' + data.badgestyle;

      modalCalories.textContent = data.calories;
      modalPrepTime.textContent = data.preptime;
      modalCooking.textContent = data.cooking;

      // Ingredients
      modalIngredients.innerHTML = '';
      try {
        const ings = JSON.parse(data.ingredients);
        ings.forEach(ing => {
          const span = document.createElement('span');
          span.className = 'ing-tag';
          span.textContent = '✓ ' + ing;
          modalIngredients.appendChild(span);
        });
      } catch (e) {
        modalIngredients.innerHTML = '<span class="ing-tag">Ingredientes seleccionados del chef</span>';
      }

      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    detailBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        openDetailsModal({
          name: btn.dataset.name,
          badge: btn.dataset.badge,
          badgestyle: btn.dataset.badgestyle,
          price: btn.dataset.price,
          desc: btn.dataset.desc,
          calories: btn.dataset.calories,
          preptime: btn.dataset.preptime,
          cooking: btn.dataset.cooking,
          bread: btn.dataset.bread,
          image: btn.dataset.image,
          ingredients: btn.dataset.ingredients
        });
      });
    });

    closeBtn.addEventListener('click', closeModal);
    secondaryClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
