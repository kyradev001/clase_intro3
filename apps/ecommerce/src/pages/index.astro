    .spec-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .card-actions-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .btn-details {
      background: #F8FAFC;
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
